# Copy this file to .env.local and fill in your Firebase web app config
# (Firebase console > Project settings > Your apps > Web app > Config).
# These values are public identifiers, not secrets; access is controlled by
# database.rules.json. Restart `npm run dev` after editing.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Multiplayer lounge server (see LOUNGE_SETUP.md), e.g.
# wss://bearden-lounge.<your-subdomain>.workers.dev/ws
# Leave empty in development to use a local server on ws://127.0.0.1:8787/ws.
VITE_LOUNGE_URL=
